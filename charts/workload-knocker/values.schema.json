{
  "type": "object",
  "required": ["config"],
  "properties": {
    "mode": {"type": "string", "enum": ["full", "scheduled-stop", "off"]},
    "api": {
      "type": "object",
      "required": ["tokenSecret"],
      "properties": {
        "tokenSecret": {
          "type": "object",
          "required": ["name", "key"],
          "properties": {
            "name": {"type": "string", "maxLength": 253},
            "key": {"type": "string", "minLength": 1, "pattern": "^[-._a-zA-Z0-9]+$"}
          }
        }
      }
    },
    "nightlyStop": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "schedule": {"type": "string", "minLength": 1},
        "timeZone": {"type": "string", "minLength": 1},
        "suspend": {"type": "boolean"},
        "startingDeadlineSeconds": {"type": "integer", "minimum": 1},
        "concurrencyPolicy": {"type": "string", "enum": ["Allow", "Forbid", "Replace"]},
        "successfulJobsHistoryLimit": {"type": "integer", "minimum": 0},
        "failedJobsHistoryLimit": {"type": "integer", "minimum": 0},
        "backoffLimit": {"type": "integer", "minimum": 0},
        "requestTimeoutSeconds": {"type": "integer", "minimum": 1},
        "curlRetries": {"type": "integer", "minimum": 0},
        "image": {
          "type": "object",
          "properties": {
            "digest": {"type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$"}
          }
        }
      }
    },
    "settings": {
      "type": "object",
      "properties": {
        "reconcileInterval": {"type": "string", "pattern": "^(0|([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+)$"},
        "defaultRunDuration": {"type": "string", "pattern": "^(0|([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+)$"},
        "maxRunDuration": {"type": "string", "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+$"},
        "stopReminder": {"type": "string", "pattern": "^(0|([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+)$"},
        "gitopsManagers": {"type": "array", "items": {"type": "string", "minLength": 1, "pattern": "^[^,\\s]+$"}},
        "rolloutPollInterval": {"type": "string", "pattern": "^([0-9]+(ns|us|ms|s|m|h))+$"},
        "rolloutWatchTimeout": {"type": "string", "pattern": "^([0-9]+(ns|us|ms|s|m|h))+$"}
      }
    },
    "replicaCount": {"type": "integer", "minimum": 0, "maximum": 1},
    "image": {
      "type": "object",
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "config": {
      "type": "object",
      "required": ["key"],
      "properties": {
        "existingConfigMap": {"type": "string", "maxLength": 253},
        "key": {"type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[-._a-zA-Z0-9]+$"},
        "inline": {"type": "object"}
      }
    },
    "externalScaler": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "tls": {
          "type": "object",
          "properties": {
            "secretName": {"type": "string", "maxLength": 253}
          }
        }
      }
    },
    "authz": {
      "type": "object",
      "required": ["enabled", "key"],
      "properties": {
        "enabled": {"type": "boolean"},
        "existingConfigMap": {"type": "string", "maxLength": 253},
        "key": {"type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[-._a-zA-Z0-9]+$"},
        "inline": {"type": "object"}
      }
    },
    "discord": {
      "type": "object",
      "properties": {
        "secretName": {"type": "string", "maxLength": 253},
        "botTokenKey": {"type": "string", "minLength": 1, "pattern": "^[-._a-zA-Z0-9]+$"},
        "guildId": {"type": "string", "pattern": "^[0-9]*$"}
      }
    },
    "slack": {
      "type": "object",
      "required": ["appTokenKey", "botTokenKey"],
      "properties": {
        "secretName": {"type": "string", "maxLength": 253},
        "appTokenKey": {"type": "string", "minLength": 1, "pattern": "^[-._a-zA-Z0-9]+$"},
        "botTokenKey": {"type": "string", "minLength": 1, "pattern": "^[-._a-zA-Z0-9]+$"}
      }
    }
  }
}
